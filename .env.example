# Copy to .env and edit. Applied on `docker compose up -d`.
SRCDS_HOSTNAME=CS:S GunGame
SRCDS_RCON_PASSWORD=change-me
SRCDS_PASSWORD=
SRCDS_PORT=27015
SRCDS_MAXPLAYERS=24
# Empty = first map of the mapcycle
SRCDS_STARTMAP=
SRCDS_LAN=0
# Public URL of your FastDL web server, e.g. http://myhost:8080  (start it with: docker compose --profile fastdl up -d)
SRCDS_FASTDL_URL=
FASTDL_PORT=8080

# Update the game on every start (recommended)
SRCDS_AUTO_UPDATE=1
# Also verify game files while updating
SRCDS_VALIDATE=0

# Maps
AUTO_MAPCYCLE=1
FETCH_MAPS=1
INCLUDE_STOCK_MAPS=1
# Base URL used for names in maps/maps.txt that have no explicit URL
MAPS_BASE_URL=https://main.fastdl.me/maps
